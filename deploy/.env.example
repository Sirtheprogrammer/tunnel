# TunnelX Docker Environment
# Copy this file to .env and fill in your values.

# Required: Your tunnel domain
TUNNEL_DOMAIN=tunnel.example.com

# Required: Email for Let's Encrypt certificate expiry notices
ACME_EMAIL=admin@example.com

# Required (for ACME mode): Cloudflare API token with Zone:DNS:Edit permission
CF_API_TOKEN=your-cloudflare-api-token-here

# Optional: TLS mode (acme or file). Default: acme
TLS_MODE=acme

# Optional: GitHub OAuth for web portal login (https://github.com/settings/developers)
# Callback URL: https://<TUNNEL_DOMAIN>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

